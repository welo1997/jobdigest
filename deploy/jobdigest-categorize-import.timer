# Monday 09:30 UTC — a full day after the export, which is the slack this job is entitled to.
#
# The matcher gives its routine one hour because a subscriber is waiting for the email. Here
# nobody is: the answers reach `postings.role_category` on the next 03:00 ingest whenever they
# land, so a day of margin costs nothing and absorbs a routine that ran late, a Drive sync
# that lagged, or a week the routine was skipped entirely (the import exits 0 and waits).
[Unit]
Description=JobDigest title classification import, weekly on Monday at 09:30

[Timer]
OnCalendar=Mon *-*-* 09:30:00
Persistent=true
Unit=jobdigest-categorize-import.service

[Install]
WantedBy=timers.target
