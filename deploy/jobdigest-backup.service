# Nightly Postgres backup. Install:
#   sudo cp deploy/jobdigest-backup.* /etc/systemd/system/
#   sudo install -m 755 deploy/jobdigest-backup.sh /usr/local/bin/jobdigest-backup.sh
#   sudo systemctl daemon-reload && sudo systemctl enable --now jobdigest-backup.timer
# Off-box copies: set JOBDIGEST_BACKUP_REMOTE below to an rclone remote.
[Unit]
Description=JobDigest Postgres backup (pg_dump -Fc, rotated)
After=docker.service
Requires=docker.service
# Email an alert if the nightly backup fails — the pgdata volume is the only copy of every
# subscriber and the digest_sends ledger. See deploy/jobdigest-alert@.service.
OnFailure=jobdigest-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/jobdigest/deploy
# Off-box copies, so backups survive losing the VPS. Uses the same `gdrive` rclone remote
# the matcher routine already authorised (see matcher-routine.md) — but a DIFFERENT folder:
# gdrive:JobDigest is shared with the claude.ai routine's Google account, Drive sharing is
# inherited by subfolders, and a dump contains every subscriber's manage token. The script
# refuses to run if this points inside the shared folder.
Environment=JOBDIGEST_BACKUP_REMOTE=gdrive:JobDigest-Backups
# Passphrase for the symmetric encryption applied before anything leaves the box. Without
# it the script keeps the local dump and skips the upload. Create it once:
#   sudo sh -c 'head -c 32 /dev/urandom | base64 > /etc/jobdigest-backup.pass'
#   sudo chmod 600 /etc/jobdigest-backup.pass
# Then store that passphrase in your password manager — it is the only way to restore an
# off-box copy.
Environment=JOBDIGEST_BACKUP_PASSPHRASE_FILE=/etc/jobdigest-backup.pass
# systemd runs as root; rclone's config was authorised as `deploy`. Without this the
# off-box copy fails with "didn't find section in config file".
Environment=RCLONE_CONFIG=/home/deploy/.config/rclone/rclone.conf
Environment=JOBDIGEST_BACKUP_DIR=/var/backups/jobdigest
Environment=JOBDIGEST_BACKUP_KEEP_DAYS=30
# Runs the copy in the deployed tree, not an installed duplicate in /usr/local/bin. A second
# copy is a second thing to forget: deploy.sh updates /opt/jobdigest, so a script living
# anywhere else silently keeps running the old version (observed 2026-07-20, when the remote
# prune shipped but the unit kept executing the previous script). Same pattern as the
# jobdigest-match-* units.
ExecStart=/opt/jobdigest/deploy/jobdigest-backup.sh backup
