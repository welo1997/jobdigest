# Nightly Postgres backup. Install:
#   sudo cp deploy/jobdigest-backup.* /etc/systemd/system/
#   sudo install -m 755 deploy/jobdigest-backup.sh /usr/local/bin/jobdigest-backup.sh
#   sudo systemctl daemon-reload && sudo systemctl enable --now jobdigest-backup.timer
# Off-box copies: set JOBDIGEST_BACKUP_REMOTE below to an rclone remote.
[Unit]
Description=JobDigest Postgres backup (pg_dump -Fc, rotated)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/jobdigest/deploy
# Off-box copies, so backups survive losing the VPS. Uses the same `gdrive` rclone remote
# the matcher routine already authorised (see matcher-routine.md).
Environment=JOBDIGEST_BACKUP_REMOTE=gdrive:JobDigest/backups
# systemd runs as root; rclone's config was authorised as `deploy`. Without this the
# off-box copy fails with "didn't find section in config file".
Environment=RCLONE_CONFIG=/home/deploy/.config/rclone/rclone.conf
Environment=JOBDIGEST_BACKUP_DIR=/var/backups/jobdigest
Environment=JOBDIGEST_BACKUP_KEEP_DAYS=30
ExecStart=/usr/local/bin/jobdigest-backup.sh backup
