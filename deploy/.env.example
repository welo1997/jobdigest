# Copy to deploy/.env and fill in. NEVER commit the real .env.
# IMPORTANT: no inline comments after values — docker compose env_file treats everything
# after "=" as the value (including a trailing "# ..."). Keep comments on their own lines.

# --- domain / TLS -----------------------------------------------------------
# Your domain, no scheme (Caddy serves it, auto-HTTPS).
SITE_DOMAIN=jobdigest.eu
# Let's Encrypt account email.
ACME_EMAIL=you@example.com
TZ=Europe/Prague

# --- database ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- email delivery ---------------------------------------------------------
# Backend: file | console | smtp | resend  (use resend or smtp in prod).
MAIL_BACKEND=resend
MAIL_FROM=JobDigest <hello@jobdigest.eu>
RESEND_API_KEY=
# ...or SMTP instead of Resend (set MAIL_BACKEND=smtp and fill these):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- bot protection (Cloudflare Turnstile) ----------------------------------
# Server secret — the API verifies tokens. Leave empty to disable bot-check (dev).
# Cloudflare always-pass TEST keys (for staging/local): site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA. Use your real widget keys in production.
TURNSTILE_SECRET=
# Public site key — baked into the web build (docker build arg).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- automation (optional n8n profile) --------------------------------------
N8N_USER=admin
N8N_PASSWORD=

# --- retention (service/pipeline.py prunes daily; defaults shown) ------------
# Blank descriptions of postings inactive this long (rows are kept for analytics).
# Descriptions are ~81% of postings table size, so this is the main growth lever.
RETENTION_DESC_DAYS=90
# Delete un-acted-on matches for postings inactive this long (saved/applied are kept).
RETENTION_MATCH_DAYS=180
# Erase unsubscribed profiles this long after they unsubscribe. The privacy policy promises
# 30 days — raising this makes the published policy untrue. Suppression rows are kept forever
# so the address is never contacted again.
RETENTION_UNSUB_DAYS=30

# --- backups (deploy/jobdigest-backup.sh + .timer) --------------------------
# rclone remote for OFF-BOX copies. A backup on the same VPS dies with the VPS.
# Set this in jobdigest-backup.service (systemd doesn't read this file).
# MUST NOT be inside gdrive:JobDigest — that folder is shared with the claude.ai matcher
# routine's Google account, and a dump contains every subscriber's manage token. Copies are
# gpg-encrypted before upload (JOBDIGEST_BACKUP_PASSPHRASE_FILE).
# JOBDIGEST_BACKUP_REMOTE=gdrive:JobDigest-Backups

# --- analytics -------------------------------------------------------------
# Raw analytics events are rolled up daily into events_daily, then deleted after this
# many days. The rollups are kept indefinitely, so trends survive pruning.
RETENTION_EVENT_DAYS=180
# Cloudflare Web Analytics beacon token (Cloudflare dash -> Analytics -> Web Analytics ->
# add a site -> copy the token). Baked into the web build; leave empty to ship no beacon
# at all. Cookieless, so no consent banner is required.
#
# It is a BUILD ARG, not a runtime variable. Setting it here and running `up -d` changes
# nothing — the value is compiled into the static export, so it needs
# `docker compose build web` and then `up -d web`. An empty value ships a site with no
# beacon and no error, which is how this sat unset while the privacy policy declared the
# processor and the dashboard showed zero traffic. Verify after a rebuild rather than
# assuming:
#     curl -s https://<domain>/en/ | grep -c cloudflareinsights   # must print 1, not 0
NEXT_PUBLIC_CF_BEACON_TOKEN=
