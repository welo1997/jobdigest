# JobDigest matcher — Phase 2: pull picks.json from Drive, load into matches, send digests.
# Installed together with jobdigest-match-export.* (see that file's header).
[Unit]
Description=JobDigest matcher import (Drive picks -> matches -> send)
After=docker.service
Requires=docker.service
# Email an alert if this fails — this is the job that actually sends the daily digest, so a
# silent failure means subscribers get nothing. See deploy/jobdigest-alert@.service.
OnFailure=jobdigest-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/jobdigest/deploy
# Override the Drive remote with: Environment=JOBDIGEST_GDRIVE_REMOTE=gdrive:YourFolder
# Runs as root; rclone's config lives under `deploy`. See the export unit for the outage
# this prevents.
Environment=RCLONE_CONFIG=/home/deploy/.config/rclone/rclone.conf
ExecStart=/opt/jobdigest/deploy/jobdigest-match.sh import
