# Runs at 08:00 UTC — after the 03:00 pipeline has finished writing postings (measured
# end ~07:30) and before the 09:00 subscriber watchdog, so if a source died the cause is in
# the mailbox ahead of the symptom. Deliberately not during the run: `last_seen_at` is being
# written throughout it, and a source measured mid-run reads stale for reasons that are not
# a fault. That is not hypothetical — on 2026-08-18 the pipeline briefly started at 05:00,
# was still classifying at 08:00, and this watchdog alerted SILENT ZERO on every source of a
# perfectly healthy run. If the pipeline's start ever moves later, this must move with it.
[Unit]
Description=JobDigest source watchdog daily at 08:00

[Timer]
OnCalendar=*-*-* 08:00:00
Persistent=true
Unit=jobdigest-source-watchdog.service

[Install]
WantedBy=timers.target
