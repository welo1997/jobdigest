# Snowflake
SNOWFLAKE_ACCOUNT=            # e.g. abc12345.eu-central-1
SNOWFLAKE_USER=
SNOWFLAKE_DATABASE=JOB_MARKET
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# Least-privilege role for routine ingest/enrich/dbt work — see README's "Snowflake
# least-privilege role" for the DDL. Use SYSADMIN/ACCOUNTADMIN only for one-off admin
# tasks (setup_snowflake.py, provisioning), never as a default.
SNOWFLAKE_ROLE=JOB_MARKET_ETL
# Keypair auth (preferred — required for CI/service users; the account enforces MFA for
# password auth, which a headless credential can never satisfy):
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/rsa_key.p8
# ...or password, for a personal account that can complete MFA interactively:
# SNOWFLAKE_PASSWORD=

# Adzuna (developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Telegram (@BotFather)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Personal scoring threshold (min score for Telegram alert)
PERSONAL_SCORE_THRESHOLD=7
