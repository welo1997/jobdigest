# Base URL of the public API (service/webapp.py). Local dev default:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8811
# Cloudflare Turnstile site key (public). Leave blank in dev — the API skips verification
# when TURNSTILE_SECRET is unset, and the widget renders a no-op placeholder.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
