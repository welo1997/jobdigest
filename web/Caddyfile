# Edge for JobDigest. Serves the static Next.js export and proxies /api/* to the backend.
# TLS: Let's Encrypt cannot renew behind the Cloudflare proxy (CF terminates TLS at its edge
# and intercepts the ACME challenge), so production serves a Cloudflare Origin Certificate
# instead — issued 2026-07-29, valid to 2041, nothing to renew. The cert and the `tls` line
# that selects it live in deploy/origin/ on the VPS and are imported below, because a private
# key must not be committed. See deploy/cert-renewal.md.

{
	email {$ACME_EMAIL:admin@example.com}
}

{$SITE_DOMAIN:localhost} {
	# Production TLS: deploy/origin/tls.caddy points Caddy at the Cloudflare Origin
	# Certificate, which overrides ACME entirely. A glob that matches nothing is a no-op
	# (verified: `caddy validate` returns "Valid configuration"), so local dev — where the
	# directory is empty or absent — keeps Caddy's automatic/internal certs. This stays one
	# committed Caddyfile everywhere: a box-local edit would be reverted by the next scp and
	# would take the site down at the following rebuild.
	import /etc/caddy/origin/*.caddy

	encode gzip zstd

	# API — strip the /api prefix, forward to the backend container.
	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	# Static site (Next.js export with trailingSlash: index.html per route).
	handle {
		root * /srv
		try_files {path} {path}/index.html {path}.html /404.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# HTTPS-only for a year, subdomains included. `preload` is deliberately omitted: it
		# commits the apex to the browser preload list and is painful to undo — add it only
		# once the domain is settled.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		# self for everything, plus Cloudflare Turnstile (script + iframe). script-src keeps
		# 'unsafe-inline' because the Next.js static export ships inline bootstrap scripts and
		# can't use per-request nonces; the served API pages use inline style attributes, hence
		# 'unsafe-inline' in style-src. object-src/base-uri/frame-ancestors stay locked down.
		# static.cloudflareinsights.com serves the Web Analytics beacon; the beacon POSTs its
		# RUM payload to cloudflareinsights.com, hence the connect-src entry. Both are needed
		# or the beacon is silently blocked and analytics look "enabled but empty".
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		-Server
	}
}
