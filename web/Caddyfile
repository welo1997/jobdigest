# Edge for JobDigest. Serves the static Next.js export and proxies /api/* to the backend.
# TLS: Let's Encrypt cannot renew behind the Cloudflare proxy (CF terminates TLS at its edge
# and intercepts the ACME challenge), so production serves a Cloudflare Origin Certificate
# instead — issued 2026-07-29, valid to 2041, nothing to renew. The cert and the `tls` line
# that selects it live in deploy/origin/ on the VPS and are imported below, because a private
# key must not be committed. See deploy/cert-renewal.md.

{
	email {$ACME_EMAIL:admin@example.com}
}

{$SITE_DOMAIN:localhost} {
	# Production TLS: deploy/origin/tls.caddy points Caddy at the Cloudflare Origin
	# Certificate, which overrides ACME entirely. A glob that matches nothing is a no-op
	# (verified: `caddy validate` returns "Valid configuration"), so local dev — where the
	# directory is empty or absent — keeps Caddy's automatic/internal certs. This stays one
	# committed Caddyfile everywhere: a box-local edit would be reverted by the next scp and
	# would take the site down at the following rebuild.
	import /etc/caddy/origin/*.caddy

	encode gzip zstd

	# API — strip the /api prefix, forward to the backend container.
	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	# Compatibility redirects — permanent, and not removable.
	#
	# The site is exported once per language (/en/preferences/, /cs/preferences/, …), so the
	# old un-prefixed paths are no longer pages. Every digest, confirmation and magic-link
	# email ever sent points at them, and mail already delivered can never be rewritten: a
	# subscriber opening a two-week-old digest to change their preferences would otherwise
	# get a 404 and no way back in. `{uri}` carries the query string, so the one-time token
	# survives the hop.
	#
	# English because the emails are English. New links are generated pre-prefixed by
	# `service/links.py`, so this catches history, not current traffic.
	# /privacy and /terms moved under the locale prefix too. They are linked from the email
	# footer and are the most-indexed pages on the site, so losing them costs search ranking
	# as well as anyone following an old bookmark.
	@legacy path /preferences /preferences/ /matches /matches/ /manage /manage/ /check-inbox /check-inbox/ /privacy /privacy/ /terms /terms/
	redir @legacy /en{uri} 301

	# Static site (Next.js export with trailingSlash: index.html per route).
	#
	# `/404.html` is NOT in the try_files chain: a fallback there is served with HTTP 200, so
	# every unknown URL became a "soft 404" — a page that says Not Found while telling every
	# crawler it is a real document. With eight locales the site now has 8× the URL surface for
	# that to happen on. `file_server` raises a real 404 instead, and `handle_errors` renders
	# the same page with the status that matches what it says.
	handle {
		root * /srv
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	# `status {err.status_code}` is the load-bearing line. Without it `file_server` answers 200
	# because it successfully served 404.html, which is the soft-404 all over again — just
	# moved one block down where it looks like it was handled.
	handle_errors {
		root * /srv
		rewrite * /404.html
		file_server {
			status {err.status_code}
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# HTTPS-only for a year, subdomains included. `preload` is deliberately omitted: it
		# commits the apex to the browser preload list and is painful to undo — add it only
		# once the domain is settled.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		# self for everything, plus Cloudflare Turnstile (script + iframe). script-src keeps
		# 'unsafe-inline' because the Next.js static export ships inline bootstrap scripts and
		# can't use per-request nonces; the served API pages use inline style attributes, hence
		# 'unsafe-inline' in style-src. object-src/base-uri/frame-ancestors stay locked down.
		# static.cloudflareinsights.com serves the Web Analytics beacon; the beacon POSTs its
		# RUM payload to cloudflareinsights.com, hence the connect-src entry. Both are needed
		# or the beacon is silently blocked and analytics look "enabled but empty".
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		-Server
	}
}

# Analytics portfolio (Metabase) — separate `metabase-portfolio` compose stack, reachable over
# the shared external `web_edge` network. TLS uses the same Cloudflare Origin cert as the apex
# (import glob), so the cert must cover analytics.jobdigest.eu (wildcard *.jobdigest.eu). Metabase
# sets its own security headers; we don't impose the apex CSP here (it would break the app UI).
analytics.jobdigest.eu {
	import /etc/caddy/origin/*.caddy
	encode gzip zstd
	reverse_proxy metabase:3000
}
