# Edge for JobDigest. Serves the static Next.js export and proxies /api/* to the backend.
# TLS: with a real {$SITE_DOMAIN} Caddy auto-provisions Let's Encrypt certs. Behind
# Cloudflare, prefer Full (strict) with a Cloudflare Origin Certificate (see deploy/README).

{
	email {$ACME_EMAIL:admin@example.com}
}

{$SITE_DOMAIN:localhost} {
	encode gzip zstd

	# API — strip the /api prefix, forward to the backend container.
	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	# Static site (Next.js export with trailingSlash: index.html per route).
	handle {
		root * /srv
		try_files {path} {path}/index.html {path}.html /404.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# HTTPS-only for a year, subdomains included. `preload` is deliberately omitted: it
		# commits the apex to the browser preload list and is painful to undo — add it only
		# once the domain is settled.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		# self for everything, plus Cloudflare Turnstile (script + iframe). script-src keeps
		# 'unsafe-inline' because the Next.js static export ships inline bootstrap scripts and
		# can't use per-request nonces; the served API pages use inline style attributes, hence
		# 'unsafe-inline' in style-src. object-src/base-uri/frame-ancestors stay locked down.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		-Server
	}
}
